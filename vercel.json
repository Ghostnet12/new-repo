{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "routes": [
    { "src": "/api", "dest": "/api/index.js" },
    { "src": "/api/(?<path>.*)", "dest": "/api/index.js?__path=$path" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
